[Unit]
Description=Spex SIM Realtime Server
After=network.target

[Service]
User=root
WorkingDirectory=/home/sim/apps/sim
EnvironmentFile=/home/sim/apps/sim/.env
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=3002
ExecStart=/bin/bash -lc "bun run dev:sockets"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
