[Unit]
Description=Spex SIM Worker
After=network.target

[Service]
User=root
WorkingDirectory=/home/sim/apps/sim
EnvironmentFile=/home/sim/apps/sim/.env
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=WORKER_PORT=3001
ExecStart=/bin/bash -lc "bun run worker"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
